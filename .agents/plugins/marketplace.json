{
  "name": "livingruntime-local",
  "interface": {
    "displayName": "LivingRuntime Local",
    "shortDescription": "Repo-local development marketplace only. Daily use is the personal marketplace under ~/.agents/plugins."
  },
  "plugins": [
    {
      "name": "livingruntime-remote",
      "source": {
        "source": "local",
        "path": "./plugins/livingruntime-remote"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    }
  ]
}
