[importlinter]
root_package = agent_runtime

[importlinter:contract:learning-not-dashboard]
name = Learning must not depend on presentation dashboard
type = forbidden
source_modules = agent_runtime.learning
forbidden_modules = agent_runtime.dashboard

[importlinter:contract:memory-not-dashboard]
name = Memory must not depend on presentation dashboard
type = forbidden
source_modules = agent_runtime.memory
forbidden_modules = agent_runtime.dashboard
