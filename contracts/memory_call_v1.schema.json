{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_call_v1.schema.json",
  "title": "MemoryCapabilityCallV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_protocol_version", "request_id", "subject_id", "capability_id", "operation", "payload"],
  "properties": {
    "capability_protocol_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "capability_id": {"const": "agent.memory"},
    "operation": {"enum": ["remember", "recall", "read", "changes", "health"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "remember"}}},
      "then": {"properties": {"payload": {
        "type": "object", "additionalProperties": false, "required": ["record"],
        "properties": {"record": {"type": "object"}}
      }}}
    },
    {
      "if": {"properties": {"operation": {"const": "recall"}}},
      "then": {"properties": {"payload": {
        "type": "object", "additionalProperties": false,
        "required": ["query", "limit", "topic", "node_types", "source_ids"],
        "properties": {
          "query": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "topic": {"type": "string"},
          "node_types": {"type": "array", "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        }
      }}}
    },
    {
      "if": {"properties": {"operation": {"const": "read"}}},
      "then": {"properties": {"payload": {
        "type": "object", "additionalProperties": false, "required": ["memory_id", "offset"],
        "properties": {
          "memory_id": {"type": "string", "minLength": 1},
          "offset": {"type": "integer", "minimum": 0}
        }
      }}}
    },
    {
      "if": {"properties": {"operation": {"const": "changes"}}},
      "then": {"properties": {"payload": {
        "type": "object", "additionalProperties": false, "required": ["since", "limit"],
        "properties": {
          "since": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      }}}
    },
    {
      "if": {"properties": {"operation": {"const": "health"}}},
      "then": {"properties": {"payload": {"type": "object", "additionalProperties": false, "maxProperties": 0}}}
    }
  ]
}
